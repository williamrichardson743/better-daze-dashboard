# ── GitHub OAuth ─────────────────────────────────────────────────
GITHUB_CLIENT_ID=          # GitHub OAuth App client ID
GITHUB_CLIENT_SECRET=      # GitHub OAuth App client secret; server-side only
APP_URL=http://localhost:3000
SESSION_SECRET=            # Long random secret used to sign dashboard sessions

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=              # MySQL connection string (mysql://user:pass@host:port/db)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=github:257014198 # GitHub user ID that receives the admin role

# ── Shopify ─────────────────────────────────────────────────────
SHOPIFY_STORE_URL=         # Shopify store URL (e.g. yourstore.myshopify.com)
SHOPIFY_ADMIN_TOKEN=       # Shopify Admin API access token
