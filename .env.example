# ── GitHub OAuth (required for the dashboard login flow) ─────────
# APP_URL must be the exact public dashboard origin. Register
# ${APP_URL}/api/oauth/callback as the GitHub OAuth App callback URL.
APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=              # GitHub OAuth App client ID; used to begin and complete OAuth
GITHUB_CLIENT_SECRET=          # GitHub OAuth App client secret; server-side only
SESSION_SECRET=                # Long random secret used to sign dashboard sessions

# ── Dashboard access control (required for the dashboard login flow) ─
OWNER_UNION_ID=                # Authorized GitHub numeric ID with `github:` prefix (e.g. github:123456)
OWNER_GITHUB_LOGIN=            # Authorized GitHub login, lowercase preferred

# ── Database (required for the dashboard login flow) ──────────────
DATABASE_URL=                  # MySQL connection string (mysql://user:pass@host:port/db)

# ── Optional commerce integrations (not required for OAuth) ──────
SHOPIFY_STORE_URL=             # Shopify store URL (e.g. yourstore.myshopify.com)
SHOPIFY_ADMIN_TOKEN=           # Shopify Admin API access token
PRINTIFY_API_TOKEN=            # Printify API token
PRINTIFY_SHOP_ID=              # Printify shop ID
