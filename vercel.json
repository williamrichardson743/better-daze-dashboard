{
  "version": 2,
  "builds": [
    {
      "src": "api/boot.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/boot.ts"
    },
    {
      "src": "/(assets|images|favicon.ico)(.*)",
      "dest": "/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
