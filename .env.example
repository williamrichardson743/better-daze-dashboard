# Better Daze Dashboard — Environment Variables
#
# Copy this file to .env for local development.
# In Railway, set these as service variables (no spaces in names).

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Printify ──────────────────────────────────────────────────────────────
PRINTIFY_API_KEY=...

# ── Shopify ───────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=...

# ── ElevenLabs ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...

# ── Ayrshare ──────────────────────────────────────────────────────────────
AYRSHARE_API_KEY=...

# ── YouTube ───────────────────────────────────────────────────────────────
# NOTE: Use YOUTUBE_API (underscore), NOT "YOUTUBE API" (space).
# Variable names with spaces break BuildKit secret resolution during builds.
YOUTUBE_API=...

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
